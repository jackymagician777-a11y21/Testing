<Window x:Class="SteamAutoLauncher.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam Auto Launcher" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        Foreground="#ffffff"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Background="#2d2d2d" Margin="20">
            <TextBlock Text="Steam Auto Launcher" FontSize="24" FontWeight="Bold" Foreground="#00ff00"/>
            <TextBlock x:Name="StatusLabel" Text="Ready" FontSize="14" Foreground="#ffff00" Margin="0,10,0,0"/>
            <TextBlock x:Name="CycleLabel" Text="Cycles: 0" FontSize="12" Foreground="#ffffff" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Logs -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Log Output -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Event Log" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                <ScrollViewer Height="500" Background="#2d2d2d" BorderBrush="#444444" BorderThickness="1">
                    <TextBlock x:Name="LogBox" 
                               Text="Ready to start..."
                               TextWrapping="Wrap"
                               Foreground="#ffffff"
                               Padding="10"
                               FontFamily="Courier New"
                               FontSize="11"/>
                </ScrollViewer>
            </StackPanel>

            <!-- Sidebar -->
            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <TextBlock Text="Configuration" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                <Border Background="#2d2d2d" BorderBrush="#444444" BorderThickness="1" CornerRadius="5" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Accounts" FontWeight="Bold" Foreground="#00ff00" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="AccountsList" Background="Transparent">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" Foreground="#ffffff" Margin="0,5" FontSize="11"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,15,0,15" Background="#444444"/>

                        <TextBlock Text="Game: Bongo Cat" FontSize="11" Foreground="#ffffff" Margin="0,5"/>
                        <TextBlock x:Name="GameSettingLabel" FontSize="11" Foreground="#aaaaaa" Margin="0,5"/>
                        
                        <Separator Margin="0,15,0,15" Background="#444444"/>

                        <TextBlock Text="Next Cycle" FontSize="11" Foreground="#ffff00"/>
                        <TextBlock x:Name="NextCycleLabel" Text="Not started" FontSize="11" Foreground="#ffffff" Margin="0,5,0,15"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Controls -->
        <StackPanel Grid.Row="2" Background="#2d2d2d" Margin="20" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="StartButton" 
                    Content="Start" 
                    Width="120" 
                    Height="40"
                    Background="#00aa00"
                    Foreground="white"
                    FontSize="14"
                    FontWeight="Bold"
                    Click="StartButton_Click"
                    Margin="0,0,10,0"/>
            <Button x:Name="StopButton" 
                    Content="Stop" 
                    Width="120" 
                    Height="40"
                    Background="#aa0000"
                    Foreground="white"
                    FontSize="14"
                    FontWeight="Bold"
                    Click="StopButton_Click"
                    IsEnabled="False"
                    Margin="0,0,10,0"/>
            <Button x:Name="ClearLogsButton" 
                    Content="Clear Logs" 
                    Width="120" 
                    Height="40"
                    Background="#444444"
                    Foreground="white"
                    FontSize="14"
                    Click="ClearLogsButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
